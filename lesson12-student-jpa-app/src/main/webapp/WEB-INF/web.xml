<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- Define a list of default files to serve when a directory is requested. -->
    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!-- Keep empty input fields as null instead of as empty strings in the model. -->
    <context-param>
        <param-name>jakarta.faces.INTERPRET_EMPTY_STRING_SUBMITTED_VALUES_AS_NULL</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Enable automatic extensionless mapping. -->
    <context-param>
        <param-name>jakarta.faces.AUTOMATIC_EXTENSIONLESS_MAPPING</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
    H2 Console for local development/debugging only.

    URL:
        http://localhost:8080/h2-console

    Use this to inspect the file-based H2 database while developing.
    Do not use the H2 Console to manually create records for your assignment demo.
-->
    <servlet>
        <servlet-name>H2Console</servlet-name>
        <servlet-class>org.h2.server.web.JakartaWebServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>H2Console</servlet-name>
        <url-pattern>/h2-console/*</url-pattern>
    </servlet-mapping>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>EnableHttps</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <security-role>
        <role-name>Sales</role-name>
    </security-role>

    <security-role>
        <role-name>Shipping</role-name>
    </security-role>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>SalesAccessOnlyResources</web-resource-name>
            <url-pattern>/students/manage-students</url-pattern>
            <url-pattern>/students/manage-students.xhtml</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>Sales</role-name>
            <role-name>Shipping</role-name>
        </auth-constraint>
    </security-constraint>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/errorpages/403.xhtml</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/errorpages/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/errorpages/500.xhtml?fromErrorPage=true</location>
    </error-page>

</web-app>